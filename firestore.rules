rules_version = '2';
// Jan Seva Kendra — Firestore security rules.
// Principle: clients READ through these rules; all WRITES to business
// collections go through Cloud Functions (validated transactions).
// Frontend hiding is never the enforcement point.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return signedIn() && role() == 'ADMIN'; }

    // ---- Geo masters: read-only for signed-in users, writes via backend ----
    match /states/{id}    { allow read: if signedIn(); allow write: if false; }
    match /districts/{id} { allow read: if signedIn(); allow write: if false; }
    match /blocks/{id}    { allow read: if signedIn(); allow write: if false; }
    match /villages/{id}  { allow read: if signedIn(); allow write: if false; }

    // ---- Services: only active ones visible; writes via admin API ----
    match /services/{id} {
      allow read: if signedIn() && resource.data.activeStatus == true;
      allow write: if false;
    }

    // ---- CSC centers: only VERIFIED + ACTIVE visible to public app ----
    match /csc_centers/{id} {
      allow read: if signedIn()
        && resource.data.verificationStatus == 'VERIFIED'
        && resource.data.accountStatus == 'ACTIVE';
      allow write: if false;
    }

    // ---- Applications: applicant, owning CSC, or admin ----
    match /applications/{id} {
      allow read: if signedIn() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.selectedCscId == request.auth.token.cscId ||
        isAdmin()
      );
      allow write: if false; // Cloud Functions only
    }

    match /application_documents/{id} {
      allow read: if signedIn() && (
        resource.data.uploadedBy == request.auth.uid ||
        isAdmin()
      );
      // CSC doc access is granted via signed download URLs minted by backend
      // after ownership check, not via direct reads.
      allow write: if false;
    }

    match /application_status_history/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Notifications: only the recipient ----
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    // ---- Users: own doc, or admin ----
    match /users/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());
      allow write: if false;
    }
    match /users/{uid}/fcmTokens/{token} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /admin_users/{id}  { allow read, write: if false; }
    match /audit_logs/{id}   { allow read: if isAdmin(); allow write: if false; }
  }
}
